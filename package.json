{
  "name": "whatisoffside",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "next dev",
    "build": "next build",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "check:biome": "biome check .",
    "check:fix": "biome check --write",
    "check:markdown": "markdownlint-cli2 README.md AGENTS.md TECH_STACK.md VISION.md DEFINITION_OF_READY.md DEFINITION_OF_DONE.md \"docs/**/*.md\"",
    "check:knip": "knip --no-progress",
    "check:fallow": "fallow --fail-on-issues",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run lint && bun run test && bun run typecheck && bun run build && bun run check:markdown && bun run check:knip && bun run check:fallow"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fallow": "2.104.0",
    "knip": "6.24.0",
    "lefthook": "2.1.9",
    "markdownlint-cli2": "0.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
